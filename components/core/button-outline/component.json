{
  "id": "core-button-outline",
  "name": "Button Outline",
  "category": "buttons",
  "library": "core",
  "version": "1.0.0",
  "description": "Botón outline IA-First: navegación secundaria (saber más, ver detalles) con menor peso visual; herramienta learnMore con intención navigate.",
  "author": "WebMCPcss Team",
  "tags": [
    "button",
    "outline",
    "navigate",
    "link",
    "core"
  ],
  "controls": [
    {
      "variable": "--wm-primary",
      "label": "Color primario",
      "type": "color",
      "default": "#2563eb"
    },
    {
      "variable": "--wm-on-primary",
      "label": "Texto sobre primario",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "variable": "--wm-radius",
      "label": "Radio",
      "type": "range",
      "default": "10px",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "variable": "--wm-btn-size",
      "label": "Tamaño de texto",
      "type": "range",
      "default": "15px",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px"
    }
  ],
  "promptExamples": [
    "cambia el borde del botón Saber más a morado",
    "convierte el botón outline en relleno"
  ],
  "animateExamples": [
    "añade un brillo al pasar el ratón por el botón outline",
    "aplica fade-in al botón Saber más"
  ],
  "related": [
    "tailwind-button-outline",
    "bootstrap-button-outline",
    "mui-button-outline",
    "shadcn-button-outline"
  ],
  "preview": "preview.css"
}
