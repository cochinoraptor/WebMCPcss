{
  "id": "core-contact-form",
  "name": "Contact Form",
  "category": "forms",
  "library": "core",
  "version": "1.0.0",
  "description": "Formulario de contacto IA-First (nombre, email, mensaje) con API declarativa WebMCP y toolautosubmit: un agente puede rellenarlo y enviarlo sin intervención.",
  "author": "WebMCPcss Team",
  "tags": [
    "form",
    "contact",
    "declarative",
    "autosubmit",
    "core"
  ],
  "controls": [
    {
      "variable": "--wm-primary",
      "label": "Color primario",
      "type": "color",
      "default": "#2563eb"
    },
    {
      "variable": "--wm-on-primary",
      "label": "Texto sobre primario",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "variable": "--wm-radius",
      "label": "Radio",
      "type": "range",
      "default": "10px",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "variable": "--wm-surface",
      "label": "Fondo de la superficie",
      "type": "color",
      "default": "#ffffff"
    }
  ],
  "promptExamples": [
    "añade un campo de teléfono al formulario de contacto",
    "cambia el color del botón Enviar mensaje"
  ],
  "animateExamples": [
    "aplica slide-up al formulario de contacto",
    "haz que el botón de enviar pulse cuando el formulario sea válido"
  ],
  "related": [
    "tailwind-contact-form",
    "bootstrap-contact-form",
    "mui-contact-form",
    "shadcn-contact-form"
  ],
  "preview": "preview.css",
  "css": "contact-form.webmcp.css",
  "html": "contact-form.html"
}
