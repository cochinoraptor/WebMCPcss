{
  "id": "tailwind-button-icon",
  "name": "Button Icon",
  "category": "buttons",
  "library": "tailwind",
  "version": "1.0.0",
  "description": "Botón con icono IA-First: acción puntual (descargar, compartir) con texto accesible y confirmación requerida; herramienta downloadReport.",
  "author": "WebMCPcss Team",
  "tags": [
    "button",
    "icon",
    "download",
    "action",
    "tailwind"
  ],
  "controls": [
    {
      "variable": "--wm-primary",
      "label": "Color primario",
      "type": "color",
      "default": "#2563eb"
    },
    {
      "variable": "--wm-on-primary",
      "label": "Texto sobre primario",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "variable": "--wm-radius",
      "label": "Radio",
      "type": "range",
      "default": "0.5rem",
      "min": 0,
      "max": 1.5,
      "step": 0.125,
      "unit": "rem"
    }
  ],
  "promptExamples": [
    "cambia el icono del botón Descargar por una flecha",
    "pon el botón con icono en gris"
  ],
  "animateExamples": [
    "haz que el botón Descargar pulse suavemente",
    "aplica slide-up al botón con icono"
  ],
  "related": [
    "core-button-icon",
    "bootstrap-button-icon",
    "mui-button-icon",
    "shadcn-button-icon"
  ],
  "preview": "preview.css",
  "css": "button-icon.webmcp.css",
  "html": "button-icon.html"
}
