{
  "name": "webmcpcss",
  "version": "1.1.0",
  "description": "Extiende el estándar WebMCP para hacer cualquier sitio web nativo para agentes de IA, con auto-reparación de selectores CSS.",
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "browser-automation",
    "css",
    "self-healing"
  ],
  "license": "MIT",
  "author": "WebMCPcss Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/cochinoraptor/WebMCPcss.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "webmcpcss": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/dashboard/public','dist/src/dashboard/public',{recursive:true})\"",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "validate:community": "node dist/scripts/validate-community.js",
    "prepublishOnly": "npm run build && npm test",
    "build:community-index": "npm run build && node dist/scripts/build-community-index.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "postcss": "^8.4.47",
    "puppeteer": "^23.5.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/cochinoraptor/WebMCPcss#readme",
  "bugs": {
    "url": "https://github.com/cochinoraptor/WebMCPcss/issues"
  }
}
