{
  "id": "tailwind-button-outline",
  "name": "Button Outline",
  "category": "buttons",
  "library": "tailwind",
  "version": "1.0.0",
  "description": "Botón outline IA-First: navegación secundaria (saber más, ver detalles) con menor peso visual; herramienta learnMore con intención navigate.",
  "author": "WebMCPcss Team",
  "tags": [
    "button",
    "outline",
    "navigate",
    "link",
    "tailwind"
  ],
  "controls": [
    {
      "variable": "--wm-primary",
      "label": "Color primario",
      "type": "color",
      "default": "#2563eb"
    },
    {
      "variable": "--wm-on-primary",
      "label": "Texto sobre primario",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "variable": "--wm-radius",
      "label": "Radio",
      "type": "range",
      "default": "0.5rem",
      "min": 0,
      "max": 1.5,
      "step": 0.125,
      "unit": "rem"
    }
  ],
  "promptExamples": [
    "cambia el borde del botón Saber más a morado",
    "convierte el botón outline en relleno"
  ],
  "animateExamples": [
    "añade un brillo al pasar el ratón por el botón outline",
    "aplica fade-in al botón Saber más"
  ],
  "related": [
    "core-button-outline",
    "bootstrap-button-outline",
    "mui-button-outline",
    "shadcn-button-outline"
  ],
  "preview": "preview.css",
  "css": "button-outline.webmcp.css",
  "html": "button-outline.html"
}
