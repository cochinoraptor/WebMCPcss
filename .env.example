# Configuración opcional de IA para `webmcpcss generate --ai`
# Copia este archivo a .env (o exporta las variables) y rellena tu API key.
# Funciona con cualquier endpoint compatible con la API de chat de OpenAI
# (OpenAI, Gemini con proxy OpenAI-compat, Ollama local, etc.).

# Obligatoria para activar la funcionalidad:
WEBMCPCSS_AI_API_KEY=

# Opcionales:
WEBMCPCSS_AI_BASE_URL=https://api.openai.com/v1
WEBMCPCSS_AI_MODEL=gpt-4o-mini
