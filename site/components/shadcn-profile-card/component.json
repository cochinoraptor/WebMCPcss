{
  "id": "shadcn-profile-card",
  "name": "Profile Card",
  "category": "cards",
  "library": "shadcn",
  "version": "1.0.0",
  "description": "Tarjeta de perfil IA-First: avatar, nombre, rol y biografía con acciones viewProfile / followUser (esta última con confirmación).",
  "author": "WebMCPcss Team",
  "tags": [
    "card",
    "profile",
    "user",
    "social",
    "shadcn"
  ],
  "controls": [
    {
      "variable": "--primary",
      "label": "Color primario",
      "type": "color",
      "default": "#18181b"
    },
    {
      "variable": "--primary-foreground",
      "label": "Texto sobre primario",
      "type": "color",
      "default": "#fafafa"
    },
    {
      "variable": "--radius",
      "label": "Radio",
      "type": "range",
      "default": "0.625rem",
      "min": 0,
      "max": 1.5,
      "step": 0.125,
      "unit": "rem"
    }
  ],
  "promptExamples": [
    "cambia el nombre de la tarjeta de perfil a Ana Ruiz",
    "oculta el botón Seguir"
  ],
  "animateExamples": [
    "aplica fade-in a la tarjeta de perfil",
    "haz que el avatar pulse suavemente"
  ],
  "related": [
    "core-profile-card",
    "tailwind-profile-card",
    "bootstrap-profile-card",
    "mui-profile-card"
  ],
  "usage": {
    "framework": "react",
    "code": "<Card data-component=\"profile-card\" data-user-id={user.id}>\n  <CardHeader className=\"flex-row items-center gap-4\">\n    <Avatar><AvatarFallback>{user.initials}</AvatarFallback></Avatar>\n    <div>\n      <CardTitle data-context=\"profile-name\">{user.name}</CardTitle>\n      <CardDescription data-context=\"profile-role\">{user.role}</CardDescription>\n    </div>\n  </CardHeader>\n  <CardContent>{user.bio}</CardContent>\n  <CardFooter className=\"gap-2\">\n    <Button data-tool=\"followUser\">Seguir</Button>\n    <Button variant=\"outline\" asChild data-tool=\"viewProfile\"><a href={user.url}>Ver perfil</a></Button>\n  </CardFooter>\n</Card>"
  },
  "preview": "preview.css",
  "css": "profile-card.webmcp.css",
  "html": "profile-card.html"
}
