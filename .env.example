# Configuración opcional de IA para `webmcpcss generate --ai`
# Copia este archivo a .env (o exporta las variables) y rellena tu API key.
# Funciona con cualquier endpoint compatible con la API de chat de OpenAI
# (OpenAI, Gemini con proxy OpenAI-compat, Ollama local, etc.).

# Obligatoria para activar la funcionalidad:
WEBMCPCSS_AI_API_KEY=

# Opcionales:
WEBMCPCSS_AI_BASE_URL=https://api.openai.com/v1
WEBMCPCSS_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# LLM opcional para `webmcpcss prompt` y la herramienta MCP webmcpcss_prompt
# (v0.7.0). Sin estas variables se usa el intérprete heurístico incorporado.
# ---------------------------------------------------------------------------
# Proveedor: ollama | openai | anthropic | none
WEBMCP_LLM_PROVIDER=

# Ollama (local, sin clave)
WEBMCP_OLLAMA_MODEL=llama3
WEBMCP_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (o endpoint compatible)
WEBMCP_OPENAI_API_KEY=
WEBMCP_OPENAI_MODEL=gpt-4o-mini
WEBMCP_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
WEBMCP_ANTHROPIC_API_KEY=
WEBMCP_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Tiempo máximo por petición al LLM (ms)
WEBMCP_LLM_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Otras variables opcionales (v1.x)
# ---------------------------------------------------------------------------
# `publish`, `retro publish`, `components publish` (fork + PR automáticos)
GITHUB_TOKEN=
# `design analyze --figma <url|clave>`
FIGMA_TOKEN=
# `security token` y validación Bearer del servidor MCP HTTP
WEBMCP_JWT_SECRET=
# `web3 pay` / `web3 deploy` (clave privada de la billetera del agente; nunca la comitees)
WEBMCP_WALLET_KEY=
# Component Hub: URL alternativa del hub o carpeta local del catálogo
WEBMCPCSS_HUB_URL=https://cochinoraptor.github.io/WebMCPcss
WEBMCPCSS_HUB_DIR=

# Puppeteer: instalar sin descargar Chromium / usar un Chrome ya instalado
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
