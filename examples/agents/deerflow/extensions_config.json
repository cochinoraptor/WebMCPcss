{
  "mcpServers": {
    "webmcpcss": {
      "enabled": true,
      "type": "stdio",
      "command": "webmcpcss",
      "args": [
        "mcp",
        "--serve",
        "--css",
        "examples/shopping-cart/webmcp.css",
        "--url",
        "https://tienda.example.com"
      ],
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 180,
      "routing": {
        "mode": "prefer",
        "priority": 60,
        "keywords": [
          "webmcp",
          "selector",
          "carrito",
          "formulario",
          "página web",
          "sitio web",
          "addToCart",
          "applyCoupon"
        ]
      }
    }
  },
  "skills": {
    "webmcp-browser": {
      "enabled": true
    }
  }
}
